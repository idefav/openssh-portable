[Unit]
Description=Independent OpenSSH UDP extension service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=sshd-udp
RuntimeDirectoryMode=0755
ExecStartPre=/opt/openssh-udp/sbin/sshd -t -f /etc/ssh/sshd_config -p 10026 -oAllowUdpForwarding=yes
ExecStart=/opt/openssh-udp/sbin/sshd -D -e -f /etc/ssh/sshd_config -p 10026 -oAllowUdpForwarding=yes
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
